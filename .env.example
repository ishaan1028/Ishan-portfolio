# Contact form (modules/portfolio/actions/sendMessage.ts)
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Where contact messages are delivered. Without a verified domain in Resend,
# this must be the email address your Resend account was created with.
CONTACT_TO_EMAIL=you@example.com
# Optional. Defaults to "Portfolio <onboarding@resend.dev>". Needs a verified domain to change.
CONTACT_FROM_EMAIL=

# Public site URL for canonical links, sitemap and share images, e.g. https://ishandhawane.dev
# Optional on Vercel: the production domain is used automatically.
NEXT_PUBLIC_SITE_URL=
